{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeDeck",
  "version": "0.5.0",
  "identifier": "com.danrave.vibedeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vide",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNzAzMUMyNDc0RjgxQkIKUldTN2dVOUh3akZ3TTZ2ZG90Wmx0Q3A0VFgwNHlqUnVIaWlFY2JoYmFEYkY4RG0xVE9xWS9iK2oK",
      "endpoints": [
        "https://github.com/danrave1234/custom-ide/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
